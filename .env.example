# ─────────────────────────────────────────────────────────────
# AppOrganizadora · variables de entorno (copia a .env y rellena)
# NUNCA subas el .env a git. Este fichero sí, sin valores reales.
# ─────────────────────────────────────────────────────────────

# ── Seguridad de la API ──────────────────────────────────────
# Clave que enviará la app iOS en la cabecera X-API-Key (mín. 32 caracteres).
# Generar:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY_MOBILE=

# ── OpenAI (capa NLP) ───────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODELO=
OPENAI_TIMEOUT_SEGUNDOS=30

# ── Google (Calendar / Tasks) ───────────────────────────────
# Rutas DENTRO del contenedor (./secrets se monta en /app/secrets).
GOOGLE_TOKEN_PATH=/app/secrets/token.json
GOOGLE_CLIENT_SECRET_PATH=/app/secrets/client_secret.json
DURACION_EVENTO_MINUTOS=60

# ── Datos y localización ────────────────────────────────────
DB_PATH=/app/data/organizadora.db
ZONA_HORARIA=Europe/Madrid

# ── Lecturas de agenda ──────────────────────────────────────
DIAS_EVENTOS=7
CACHE_AGENDA_SEGUNDOS=60

# ── Worker ──────────────────────────────────────────────────
# Backoff: min(BASE · 2^intento, MAX) segundos → 10, 20, 40, 80, 160
WORKER_MAX_INTENTOS=5
WORKER_BACKOFF_BASE_SEGUNDOS=5
WORKER_BACKOFF_MAX_SEGUNDOS=300
# Tope de espera del bucle aunque nadie lo despierte (red de seguridad)
WORKER_ESPERA_MAX_SEGUNDOS=30

LOG_LEVEL=INFO
